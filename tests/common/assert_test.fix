module AssertTest;

import Minilib.Common.Assert::{assert_eq_lazy, assert_lazy};
import Minilib.Testing.UnitTest::{make_test, run_test_driver, TestCase};
import Std::{IO, Monad::pure};

test_assert_lazy: TestCase;
test_assert_lazy = (
    make_test("test_assert_lazy") $ |_|
    assert_lazy(|_| "err", 1 == 1) $ |_|
    pure()
);

test_assert_eq_lazy: TestCase;
test_assert_eq_lazy = (
    make_test("test_assert_eq_lazy") $ |_|
    assert_eq_lazy(|_| "err", 1, 1) $ |_|
    pure()
);

main: IO ();
main = (
    [
        test_assert_lazy,
        test_assert_eq_lazy,
    ]
    .run_test_driver
);
